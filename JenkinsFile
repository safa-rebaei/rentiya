pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps { 
        checkout scm 
      }
    }

    stage('Setup') {
      steps {
        bat 'node -v && npm -v'
        bat 'npm ci'
      }
    }

    stage('Build') {
      steps {
        bat 'npm run build'
      }
      post {
        failure {
          archiveArtifacts artifacts: 'build/**', fingerprint: true
        }
      }
    }

    stage('Run (Docker)') {
      steps {
        bat 'docker build -t rentiya:test -f Dockerfile .'
        bat 'docker run -d --rm -p 8080:80 --name rentiya_test rentiya:test'
      }
      post {
        always {
          bat 'timeout /t 2'  // pause de 2 secondes sous Windows
        }
      }
    }

    stage('Smoke Test') {
      steps {
        // Lancer le script PowerShell ou un équivalent Windows
        bat 'powershell -ExecutionPolicy Bypass -File scripts\\smoke_test.ps1 http://localhost:8080 || (docker logs rentiya_test & exit 1)'
      }
    }

    stage('Archive Artifacts') {
      steps {
        archiveArtifacts artifacts: '**\\build\\**, **\\npm-debug.log', fingerprint: true
        junit allowEmptyResults: true, testResults: '**\\reports\\*.xml'
      }
    }
  }

  post {
    always {
      bat 'docker ps -a || exit 0'
      bat 'docker rm -f rentiya_test || exit 0'
    }
  }
}
