pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps { 
        checkout scm 
      }
    }

    stage('Setup') {
      steps {
        bat 'node -v && npm -v'
        bat 'npm ci'
      }
    }

    stage('Build') {
      steps {
        bat 'npm run build'
      }
      post {
        failure {
          archiveArtifacts artifacts: 'build/**', fingerprint: true
        }
      }
    }

    stage('Run (Docker)') {
      steps {
        bat 'docker build -t rentiya:test -f Dockerfile .'
        bat 'docker run -d --rm -p 8080:80 --name rentiya_test rentiya:test'
      }
      post {
        always {
          bat 'timeout /t 2'  // pause de 2 secondes sous Windows
        }
      }
    }
stage('Run (Docker)') {
  steps {
    bat 'docker build -t rentiya:test -f Dockerfile .'
    bat 'docker run -d --rm -p 8082:80 --name rentiya_test rentiya:test'  // <-- ici 8082:80
  }
  post {
    always {
      bat 'timeout /t 2'
    }
  }
}

stage('Smoke Test') {
  steps {
    bat 'powershell -ExecutionPolicy Bypass -File scripts\\smoke_test.ps1 http://localhost:8082 || (docker logs rentiya_test & exit 1)'  // <-- ici http://localhost:8082
  }
}


  post {
    always {
      bat 'docker ps -a || exit 0'
      bat 'docker rm -f rentiya_test || exit 0'
    }
  }
}
